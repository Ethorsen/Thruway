{
    "name": "thruway/router",
    "version": "1.0.0",
    "description": "Thruway WAMP router core",
    "repositories": [
        { "url": "packages/raw-socket-transport", "type": "path", "options": { "symlink": true } },
        { "url": "packages/ratchet-transport", "type": "path", "options": { "symlink": true } }
    ],
    "license": "MIT",
    "keywords": [
        "WebSockets",
        "Server",
        "Client",
        "WAMP",
        "WAMP2",
        "Autobahn",
        "Sockets"
    ],
    "authors": [
        {
            "name": "Matt Bonneau", "email": "matt@bonneau.net", "role": "Developer"
        },

        {
            "name": "David Dan", "email": "davidwdan@gmail.com", "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Thruway\\": "src/"
        }
    },
    "require": {
        "voryx/thruway-common": "^1.0.6",
        "thruway/client": "^0.5.8",
        "react/event-loop": "^1.6.0",
        "react/promise": "^2.11.0",
        "thruway/ratchet-transport": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.3",
        "thruway/pawl-transport": "^0.5.2",
        "thruway/raw-socket-transport": "^1.0"
    }
}
